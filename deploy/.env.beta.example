# HolyMoly beta: én skole, enkel tilstand. Kopiér til deploy/.env og udfyld. Se docs/PROXMOX.md.
# Filen deploy/.env indeholder hemmeligheder og må aldrig committes.

# Serverens adresse (står på skrive-beviserne)
PUBLIC_URL=https://holymoly.dit-domæne.dk
# B. Caddy: domænet, som Caddy henter et certifikat til
HM_DOMAIN=holymoly.dit-domæne.dk
# A. Cloudflare-tunnel: tokenet fra Cloudflare (ellers tom)
CLOUDFLARE_TUNNEL_TOKEN=

# Enkel tilstand (1 = beta til én skole)
SIMPLE=1
# 0 = testserver: beviserne mærkes "Testserver – må ikke bruges til bedømmelse".
# Sæt kun 1, når skolens IT driver serveren og har signeringsnøglen.
SCHOOL_OPERATED=0

# Skolens ja. Uden alle fire kan der ikke startes lektioner. Eleverne kan godt tilmelde sig.
# Den dataansvarlige skole, fx "Aarhus Gymnasium, CVR 12345678"
DATAANSVARLIG=
# Skolens databeskyttelsesrådgiver (DPO), fx dpo@kommune.dk
DPO_KONTAKT=
# Dato for konsekvensanalysen (DPIA), fx 2026-11-01
DPIA_DATO=
# Dato for ledelsens ja, fx 2026-11-15
LEDELSE_JA_DATO=

# HolyMoly-vagten (SYSTEM/root) er et tilvalg i beta. 1 = kræv vagten på Windows og Mac.
REQUIRE_GUARD=0
# Ældste elev-app, der må forbinde (tom = alle), fx 1.4.0
MIN_AGENT_VERSION=
# Hvor eleverne henter appen (tom = filerne i /data/downloads)
AGENT_DOWNLOAD_URL=

# Kun disse proxyer må sætte X-Forwarded-For (værtsnavne i compose, IP-adresser eller net)
TRUST_PROXY=caddy,cloudflared
# Antal daglige kopier af databasen i /data/backup (0 = ingen)
BACKUP_DAYS=14
# Kladder, afspilning, afleverede dokumenter og beviser (dage/år) – se server/src/retention.js
DRAFT_DAYS=60
VERSIONS_DAYS=60
DOC_RETENTION_DAYS=365
CERT_YEARS=3
# Overvågningslog og skærmbilleder slettes efter så mange dage
LOG_RETENTION_DAYS=30
# Lærerens login holder højst så mange timer (1-24)
SESSION_MAX_HOURS=12
# Hvor sikkerhedsfejl meldes (/.well-known/security.txt). Tom = ingen
SECURITY_CONTACT=
