HM_DOMAIN=app.holymoly.dk
# Serverens offentlige adresse (links i e-mails og på skrive-beviser)
PUBLIC_URL=https://app.holymoly.dk

# --- Hostet HolyMoly, der sælges som licens til skoler (se docs/SALG.md) ---
# Den fulde udgave (compose starter ellers i enkel tilstand; beta: se .env.beta.example)
SIMPLE=0
# Skoler, 30 dages prøveperiode og licens. 0 = skolens egen server uden licens.
LICENSING=1
TRIAL_DAYS=30
# Pris i kr. pr. elev pr. år og mindstepris pr. år (begge ekskl. moms)
PRICE_PER_STUDENT=129
PRICE_MINIMUM=2500
# To-faktor (godkendelses-app) kræves ved login med e-mail. Unilogin bruger sin egen sikkerhed.
REQUIRE_2FA=1
# open = alle kan oprette en skole; closed = kun med invitation
SIGNUP=open
# Jeres egne administratorer (aktiverer licenser på /admin) – kommasepareret
PLATFORM_ADMINS=dig@holymoly.dk
# Hvem får besked om nye skoler og bestillinger
SALES_EMAIL=salg@holymoly.dk
# E-mail (bekræft e-mail, glemt adgangskode, invitationer). Fx Simply.com, Mailgun EU eller Postmark.
SMTP_URL=smtps://bruger:kode@smtp.eksempel.dk:465
MAIL_FROM=HolyMoly <noreply@holymoly.dk>
# Vises på hjemmesiden, i vilkår og i databehandleraftalen
COMPANY_NAME=HolyMoly ApS
COMPANY_CVR=
COMPANY_ADDRESS=
COMPANY_EMAIL=kontakt@holymoly.dk
HOSTING_PROVIDER=Hetzner Online GmbH (Tyskland)
# Skolens data slettes så mange dage efter, at prøveperiode og licens er udløbet (varsel 30 og 7 dage før; 0 = aldrig)
PURGE_AFTER_DAYS=90
# Hvor sikkerhedsfejl meldes (/.well-known/security.txt); tom = COMPANY_EMAIL
SECURITY_CONTACT=
# Lærerens login holder højst så mange timer, uanset aktivitet (1–24)
SESSION_MAX_HOURS=12

# --- Skolens egen server (uden licens) ---
# Kræv en skolekode for at oprette lærere (tom = ingen kode)
TEACHER_SIGNUP_CODE=
LOG_RETENTION_DAYS=30
AGENT_DOWNLOAD_URL=https://github.com/DIN-ORG/HolyMoly/releases/latest

# Unilogin (STIL's Unilogin Broker, OpenID Connect). Se docs/UNILOGIN.md for tilslutningen hos STIL.
# Uden disse logger lærere ind med e-mail + to-faktor, og elever tilmelder sig med klassekode + navn.
UNILOGIN_CLIENT_ID=
UNILOGIN_CLIENT_SECRET=
UNILOGIN_REDIRECT_URI=https://app.holymoly.dk/api/auth/unilogin/callback
# Standard: produktionsbrokeren https://broker.unilogin.dk/auth/realms/broker (sæt testbrokeren under test)
UNILOGIN_ISSUER=
UNILOGIN_SCOPE=openid
# Brugertypen står i "aktoer_gruppe"; lærere genkendes på denne regex (roller fra dataaftalen tæller også med)
UNILOGIN_ROLE_CLAIM=aktoer_gruppe
UNILOGIN_TEACHER_ROLES=l(æ|ae)rer|p(æ|ae)dagog|ansat|medarbejder
UNILOGIN_ID_CLAIM=uniid
# Valgfrit sikringsniveau (NSIS), fx https://data.gov.dk/concept/core/nsis/loa/Substantial
UNILOGIN_ACR=
# 1 = elever må også skrive deres navn selv, selv om Unilogin er slået til (standard: nej)
UNILOGIN_OPTIONAL=0
