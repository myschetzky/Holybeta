{
  "manifest_version": 3,
  "name": "HolyMoly",
  "short_name": "HolyMoly",
  "version": "1.1.0",
  "description": "Hører til HolyMoly-appen. Blokerer AI, sociale medier og spil – kun mens læreren har startet en lektion og HolyMoly-appen er åben.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "HolyMoly", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.js", "blocked.css", "rules.js", "icons/icon48.png"], "matches": ["<all_urls>"], "use_dynamic_url": true }
  ],
  "incognito": "spanning",
  "minimum_chrome_version": "116"
}
